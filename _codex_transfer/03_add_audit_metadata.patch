+def apply_audit_metadata(calcs):
+    by_slug = {c["slug"]: c for c in calcs}
+    missing = sorted(set(AUDIT_METADATA) - set(by_slug))
+    assert not missing, "Метаданные ссылаются на неизвестные калькуляторы: %s" % missing
+    for slug, data in AUDIT_METADATA.items():
+        calc = by_slug[slug]
+        for key, value in data.items():
+            assert key not in calc, "%s уже содержит поле %s" % (slug, key)
+            calc[key] = value
