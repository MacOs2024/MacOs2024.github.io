{
  "slug": "sechenie-pe-provodnika",
  "rule": "S<=16 -> PE=S; 16<S<=35 -> PE=16; S>35 -> PE=S/2; для отдельного PE минимум 2,5 мм² с механической защитой или 4 мм² без неё; затем округление вверх",
  "note": "Ожидаемые значения выписаны вручную из правила и стандартного ряда, а не вычислены кодом страницы.",
  "series": [
    1,
    1.5,
    2.5,
    4,
    6,
    10,
    16,
    25,
    35,
    50,
    70,
    95,
    120,
    150,
    185,
    240
  ],
  "cases": [
    {
      "name": "малое сечение: PE равен фазе",
      "s": "1,5",
      "pe_calc": 1.5,
      "pe_std": 1.5,
      "expect": [
        "Расчётное сечение PE1,5 мм²",
        "Принять по стандартному ряду1,5 мм²",
        "S(PE) = S(ф) при S(ф) ≤ 16"
      ]
    },
    {
      "name": "отдельный PE с механической защитой: минимум 2,5",
      "s": "1,5",
      "layout": "separate-protected",
      "pe_calc": 2.5,
      "pe_std": 2.5,
      "expect": [
        "Минимум по способу прокладки2,5 мм²",
        "Расчётное сечение PE2,5 мм²",
        "Принять по стандартному ряду2,5 мм²"
      ]
    },
    {
      "name": "отдельный PE без механической защиты: минимум 4",
      "s": "1,5",
      "layout": "separate-unprotected",
      "pe_calc": 4,
      "pe_std": 4,
      "expect": [
        "Минимум по способу прокладки4 мм²",
        "Расчётное сечение PE4 мм²",
        "Принять по стандартному ряду4 мм²"
      ]
    },
    {
      "name": "механический минимум не уменьшает табличный результат",
      "s": "25",
      "layout": "separate-unprotected",
      "pe_calc": 16,
      "pe_std": 16,
      "expect": [
        "Минимум по способу прокладки4 мм²",
        "Расчётное сечение PE16 мм²",
        "Принять по стандартному ряду16 мм²"
      ]
    },
    {
      "name": "граница 16 включительно: ещё равен фазе",
      "s": "16",
      "pe_calc": 16,
      "pe_std": 16,
      "expect": [
        "Расчётное сечение PE16 мм²",
        "S(PE) = S(ф) при S(ф) ≤ 16"
      ]
    },
    {
      "name": "чуть выше 16: включается фиксированные 16",
      "s": "16,1",
      "pe_calc": 16,
      "pe_std": 16,
      "expect": [
        "Расчётное сечение PE16 мм²",
        "S(PE) = 16 мм² при 16 < S(ф) ≤ 35"
      ]
    },
    {
      "name": "25 — типичная ловушка: 16, а не 12,5",
      "s": "25",
      "pe_calc": 16,
      "pe_std": 16,
      "expect": [
        "Расчётное сечение PE16 мм²",
        "Принять по стандартному ряду16 мм²"
      ],
      "reject": [
        "12,5"
      ]
    },
    {
      "name": "граница 35 включительно: ещё фиксированные 16",
      "s": "35",
      "pe_calc": 16,
      "pe_std": 16,
      "expect": [
        "Расчётное сечение PE16 мм²",
        "S(PE) = 16 мм² при 16 < S(ф) ≤ 35"
      ]
    },
    {
      "name": "чуть выше 35: включается половина",
      "s": "35,1",
      "pe_calc": 17.55,
      "pe_std": 25,
      "expect": [
        "Расчётное сечение PE17,55 мм²",
        "Принять по стандартному ряду25 мм²",
        "S(PE) = S(ф)/2 при S(ф) > 35"
      ]
    },
    {
      "name": "50: половина попадает в ряд точно",
      "s": "50",
      "pe_calc": 25,
      "pe_std": 25,
      "expect": [
        "Расчётное сечение PE25 мм²",
        "Принять по стандартному ряду25 мм²"
      ]
    },
    {
      "name": "95: половина 47,5 округляется вверх до 50",
      "s": "95",
      "pe_calc": 47.5,
      "pe_std": 50,
      "expect": [
        "Расчётное сечение PE47,5 мм²",
        "Принять по стандартному ряду50 мм²"
      ]
    },
    {
      "name": "480: половина 240 — верх ряда, не должно быть нуля",
      "s": "480",
      "pe_calc": 240,
      "pe_std": 240,
      "expect": [
        "Принять по стандартному ряду240 мм²"
      ],
      "reject": [
        "ряду0 мм²",
        "вне таблицы"
      ]
    },
    {
      "name": "600: половина 300 выходит за ряд — честное сообщение вместо нуля",
      "s": "600",
      "pe_calc": 300,
      "expect": [
        "вне таблицы стандартного ряда",
        "термическую стойкость"
      ],
      "reject": [
        "Принять по стандартному ряду0 мм²"
      ]
    }
  ],
  "invalid": [
    {
      "name": "ноль",
      "s": "0"
    },
    {
      "name": "отрицательное",
      "s": "-16"
    },
    {
      "name": "пустое",
      "s": ""
    },
    {
      "name": "мусор после числа",
      "s": "12abc"
    }
  ],
  "must_not_contain": {
    "note": "Признаки прежних дефектов: строка результата с N, фиктивный вывод про пересчёт и коэффициент 1,6 как готовое решение.",
    "patterns": [
      "Сечение нулевого рабочего N",
      "нужен пересчёт по проводимости",
      "в 1,6 раза толще"
    ]
  }
}
