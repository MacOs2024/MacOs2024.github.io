{
  "slug": "tok-korotkogo-zamykaniya",
  "formula": "Iкз,min = 0,8 · Uф / Z; порог = k · In; запас = Iкз,min / порог; Zпред = 0,8 · Uф / (k · In)",
  "source": "Schneider Electric Electrical Installation Guide, Calculation of minimum levels of short-circuit current, accessed 2026-08-10",
  "note": "Ожидаемые значения посчитаны независимо и записаны литералами. Коэффициенты 0,95 и 1,00 запрещены: это не режимы конвенционального метода.",
  "cases": [
    {
      "name": "Контрпример аудита: полное Z, условие не выполняется",
      "inputs": {"u": "220", "z": "1,2", "zbasis": "design", "tip": "10", "in": "16"},
      "expect": ["Ток по номинальному напряжению183,33 А", "Оценка минимального тока Iкз,min146,67 А", "Порог мгновенного расцепителя160 А", "Коэффициент запаса Iкз,min / порог0,9167", "СтатусУсловие метода не выполняется"],
      "reject": ["СтатусПроходит", "СтатусУсловие метода выполняется"]
    },
    {
      "name": "Полное Z: условие выполняется с запасом",
      "inputs": {"u": "220", "z": "0,5", "zbasis": "design", "tip": "10", "in": "16"},
      "expect": ["Оценка минимального тока Iкз,min352 А", "Коэффициент запаса Iкз,min / порог2,2", "СтатусУсловие метода выполняется"],
      "reject": ["СтатусПроходит"]
    },
    {
      "name": "Измерение без температурной поправки: итогового вывода нет",
      "inputs": {"u": "220", "z": "0,5", "zbasis": "measured", "tip": "10", "in": "16"},
      "expect": ["Оценка минимального тока Iкз,min352 А", "СтатусНедостаточно данных", "максимальной допустимой рабочей температуре"],
      "reject": ["Условие метода выполняется", "СтатусПроходит"]
    },
    {
      "name": "Приближённое Z: итогового вывода нет",
      "inputs": {"u": "220", "z": "0,5", "zbasis": "estimate", "tip": "10", "in": "16"},
      "expect": ["СтатусНедостаточно данных"],
      "reject": ["Условие метода выполняется", "СтатусПроходит"]
    },
    {
      "name": "Граница: Iкз,min ровно равен порогу",
      "inputs": {"u": "220", "z": "1,1", "zbasis": "design", "tip": "10", "in": "16"},
      "expect": ["Оценка минимального тока Iкз,min160 А", "Коэффициент запаса Iкз,min / порог1", "СтатусУсловие метода выполняется"]
    },
    {
      "name": "Граница: Z чуть выше предельного",
      "inputs": {"u": "220", "z": "1,101", "zbasis": "design", "tip": "10", "in": "16"},
      "expect": ["Оценка минимального тока Iкз,min159,85 А", "СтатусУсловие метода не выполняется"],
      "reject": ["СтатусУсловие метода выполняется"]
    },
    {
      "name": "Характеристика B использует верхнюю границу 5 In",
      "inputs": {"u": "220", "z": "1,2", "zbasis": "design", "tip": "5", "in": "16"},
      "expect": ["Порог мгновенного расцепителя80 А (5·In)", "СтатусУсловие метода выполняется"]
    },
    {
      "name": "Характеристика D использует верхнюю границу 20 In",
      "inputs": {"u": "220", "z": "1,2", "zbasis": "design", "tip": "20", "in": "16"},
      "expect": ["Порог мгновенного расцепителя320 А (20·In)", "СтатусУсловие метода не выполняется"]
    }
  ],
  "invalid": [
    {"name": "нулевая петля", "inputs": {"u": "220", "z": "0", "zbasis": "design", "tip": "10", "in": "16"}},
    {"name": "отрицательный номинал", "inputs": {"u": "220", "z": "1,2", "zbasis": "design", "tip": "10", "in": "-16"}},
    {"name": "пустое напряжение", "inputs": {"u": "", "z": "1,2", "zbasis": "design", "tip": "10", "in": "16"}},
    {"name": "мусор после числа", "inputs": {"u": "220", "z": "1,2abc", "zbasis": "design", "tip": "10", "in": "16"}}
  ],
  "must_not_contain": ["value=\"0.95\"", "value=\"1\" selected", "Коэффициент напряжения при КЗ", "СтатусПроходит"]
}
